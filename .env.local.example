# ============================================
# THE EYE / ORACLE SYSTEM - Environment Config
# ============================================
# Copy this file to .env.local and fill in your values
# ALL SERVICES BELOW ARE FREE TIER

# ============================================
# TELEGRAM BOT (FREE - Unlimited messages)
# ============================================
# Create a bot via @BotFather on Telegram
# Get the token it gives you
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Create a channel, add your bot as admin
# Get the channel ID (starts with @ or -100)
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id

# ============================================
# DISCORD WEBHOOKS (FREE - Unlimited)
# ============================================
# Create a webhook in your Discord server settings
# Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ============================================
# EMAIL ALERTS (FREE - 3000 emails/month)
# ============================================
# Sign up at https://resend.com (free tier)
RESEND_API_KEY=re_your_resend_api_key

# Email to send from (must verify domain or use Resend's test domain)
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Comma-separated list of recipients
ALERT_TO_EMAILS=admin@example.com,team@example.com

# ============================================
# ADMIN DASHBOARD SECURITY
# ============================================
# Set a strong password for the admin dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password

# ============================================
# API KEYS (ALL FREE TIERS)
# ============================================
# CanLII API (Free for non-commercial use)
# Request at: https://www.canlii.org/en/api/
CANLII_API_KEY=your_canlii_api_key

# Open Government Canada - No API key required (public CKAN)
# LEGISinfo - No API key required (public XML feeds)
# Ontario Open Data - No API key required (public CKAN)

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Base URL for the site (used in alerts and links)
NEXT_PUBLIC_SITE_URL=https://injuredworkersunite.pages.dev

# Data directory (relative to project root)
DATA_DIR=./data

# ============================================
# OPTIONAL: WEBHOOK ENDPOINTS
# ============================================
# Custom webhook for external integrations
# CUSTOM_WEBHOOK_URL=https://your-webhook-endpoint.com/receive

# ============================================
# SLACK WEBHOOKS (FREE - Unlimited)
# ============================================
# Create a Slack app at https://api.slack.com/apps
# Enable Incoming Webhooks and add to workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ============================================
# SMS DELIVERY (TWILIO)
# ============================================
# Sign up at https://www.twilio.com (free trial available)
# Get your credentials from the dashboard
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PUSH NOTIFICATIONS (VAPID)
# ============================================
# Generate keys with: npm install -g web-push && web-push generate-vapid-keys
# Used for browser/mobile push notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@injuredworkersunite.org

# ============================================
# EMAIL CONFIGURATION
# ============================================
# From email address (must be verified in Resend)
FROM_EMAIL=alerts@injuredworkersunite.org

# ============================================
# SITE CONFIGURATION
# ============================================
# Base URL for generating links in notifications
SITE_URL=https://injuredworkersunite.pages.dev

# Data directory for preferences and delivery logs
DATA_DIR=./data

# ============================================
# GITHUB ACTIONS SECRETS
# ============================================
# When setting up GitHub Actions, add these as repository secrets:
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_CHAT_ID
# - DISCORD_WEBHOOK_URL
# - SLACK_WEBHOOK_URL (optional)
# - RESEND_API_KEY
# - TWILIO_ACCOUNT_SID (optional)
# - TWILIO_AUTH_TOKEN (optional)
# - TWILIO_PHONE_NUMBER (optional)
# - VAPID_PUBLIC_KEY (optional)
# - VAPID_PRIVATE_KEY (optional)
# - CANLII_API_KEY
# These are referenced in .github/workflows/automated-ingestion.yml
